# Copy to .env only for an external development MySQL instance.
# Start-Dev.ps1 creates a random local password automatically when .env is absent.
# The backend also loads this file at startup when it exists (spring.config.import
# in backend/src/main/resources/application.yml), so running from an IDE needs no
# extra environment variables; machines without .env are unaffected.
DB_HOST=127.0.0.1
DB_PORT=13307
DB_NAME=copper_phase2_dev
DB_USER=phase2_app
DB_PASSWORD=replace_with_your_local_password
SERVER_PORT=18280
